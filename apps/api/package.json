{
  "name": "api",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run build:ts && tsc -p test/tsconfig.json && c8 node --test -r ts-node/register \"test/**/*.ts\"",
    "clean": "node -e \"const fs=require('node:fs'); if(fs.existsSync('dist')) for(const entry of fs.readdirSync('dist')) fs.rmSync(require('node:path').join('dist',entry), {recursive:true,force:true})\"",
    "start": "npm run build:ts && fastify start -l info dist/app.js",
    "build:ts": "npm run clean && tsc",
    "watch:ts": "tsc -w",
    "dev": "npm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:dev:start\"",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P --address ${API_HOST:-127.0.0.1} --port ${PORT:-17591} dist/app.js",
    "type-check": "tsc --noEmit && tsc -p test/tsconfig.json",
    "acquire": "npm run build:ts && node dist/availability/cli.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/sensible": "^6.0.0",
    "cheerio": "1.2.0",
    "fastify": "^5.0.0",
    "fastify-cli": "^8.0.3",
    "fastify-plugin": "^6.0.0",
    "tough-cookie": "6.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "c8": "^12.0.0",
    "concurrently": "^10.0.1",
    "fastify-tsconfig": "^3.0.0",
    "ts-node": "^10.4.0",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  }
}
